# Copy this file to .env and fill in your values for local development.
# Never commit .env to source control.

# DataForSEO credentials (https://app.dataforseo.com/api-dashboard)
DATAFORSEO_LOGIN=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password

# Static API key — any string you choose (send as X-API-Key header)
API_KEY=your_super_secret_key

# DynamoDB table name (must exist in your AWS account for local testing)
DYNAMODB_TABLE_NAME=trend-spotter

# AWS region
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
